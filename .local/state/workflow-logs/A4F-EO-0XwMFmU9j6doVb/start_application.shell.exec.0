9:04:45 PM [express] GET /api/settings 200 in 493ms :: {"_id":"699c56f0487125d082222b74","associationName":"جمعية طويق للخدمات الإنسانية","associationNameEn":"Tuwaiq Humanitarian Services Association","bankAccounts":[{"bank":"مصرف الراجحي","iban":"SA3080 0005896080195679 23"},{"bank":"ANB البنك العربي الوطني","iban":"SA6930 4001809581039 0018"},{"bank":"بنك البلاد","iban":"SA2315 0009999146128000007"}],"instagram":"","licenseNumber":"17660","phone":"+966505793012","registrationNumber":"1000823030","twitter":"tuwaiq_2o3o","address":"","bankAccountName":"","bankIban":"","bankName":"","email":"","employee_fees_percentage":"10","enableBankTransfer":true,"enableOnlinePayment":true,"facebook":"","logoUrl":"","rajhiMerchantId":"600004862","rajhiSecretKey":"","rajhiTerminalId":"PG580400","showDonationStats":false,"siteName":"جمعية طويق للخدمات الإنسانية","siteNameEn":"Tuwaiq Humanitarian Services Association","totalBeneficiaries":"","totalOrganizations":"","updatedAt":"2026-03-26T04:31:44.492Z","website":"","whatsapp":"","youtube":"","enableRajhiPayment":true,"paymobHmacSecret":"","paymobIntegrationId":"23841","paymobPublicKey":"","paymobSecretKey":"","rajhiResourceKey":"60851692600660851692600660851692","rajhiTranportalId":"B0EN812lxCZ5gwa","rajhiTranportalPassword":"$1j$179KA!lplLE"}
9:05:26 PM [express] GET /api/content/about 200 in 66ms :: {"_id":"697f8c26ac2a28bf645835bb","slug":"about","content":"<h1 class=\"ql-align-center\">نشأة الجمعية</h1><p class=\"ql-align-center\">تأسست جمعية طويق للخدمات الإنسانية في مدينة الرياض كمؤسسة أهلية غير ربحية تهدف إلى خدمة الفئات الأشد احتياجًا من خلال برامج إنسانية مستدامة.</p><p class=\"ql-align-center\">جاء تأسيس الجمعية استجابةً للحاجة المجتمعية المتزايدة لدعم الأسر المتعففة وتوفير الاحتياجات الأساسية لها، خاصة في المواسم ذات الأثر الكبير مثل شهر رمضان المبارك.</p><p class=\"ql-align-center\">انطلقت الجمعية برؤية واضحة تركز على إطعام الجائعين وتوفير المياه الصالحة للشرب والمساهمة في تخفيف الأعباء المعيشية عن الأسر المحتاجة.</p><p class=\"ql-align-center\">حرص المؤسسون على أن يكون العمل منظمًا ومبنيًا على أسس نظامية متوافقة مع أنظمة المملكة العربية السعودية.</p><p class=\"ql-align-center\">منذ البداية وضعت الجمعية أهدافًا استراتيجية تسعى لتحقيق أثر مباشر وملموس في حياة المستفيدين.</p><p class=\"ql-align-center\">كما اعتمدت مبدأ الشفافية في إدارة الموارد والتبرعات لضمان وصول الدعم إلى مستحقيه.</p><p class=\"ql-align-center\">وسعت الجمعية إلى بناء شراكات مع أهل الخير والمؤسسات الداعمة لتعزيز استدامة برامجها.</p><p class=\"ql-align-center\">تعمل الجمعية وفق خطط تشغيلية سنوية تراعي الأولويات الإنسانية الأكثر إلحاحًا.</p><p class=\"ql-align-center\">وتولي اهتمامًا خاصًا بالمشاريع الموسمية ذات البعد الديني والاجتماعي.</p><p class=\"ql-align-center\">وتستمر الجمعية في التوسع والتطوير لخدمة المجتمع بشكل أفضل وأكثر فاعلية.</p><p class=\"ql-align-right\"><br></p>","title":"","updatedAt":"2026-02-27T04:30:39.657Z","titleEn":"","metaDescription":"نشأة الجمعية\n\nجمعية طويق للخدمات الإنسانية جمعية خيرية في الرياض تأسست لخدمة المجتمع عبر مشاريع السلة الرمضانية وسقيا الماء وإفطار الصائمين وإطعام الجائعين وفق ","contentEn":"","imageUrl":"/uploads/1771984211456-753639049.jpeg","metaDescriptionEn":"","videoUrl":"","images":["/api/uploads/69a11deb71b8ae0097b3ce28"],"id":"697f8c26ac2a28bf645835bb"}
9:05:33 PM [express] GET /api/content/founders 200 in 66ms :: {"_id":"698109e2ac2a28bf6459451f","slug":"founders","content":"<h3 class=\"ql-direction-rtl ql-align-center\"><strong>الأعضاء الأوائل — حفظهم الله</strong></h3><p class=\"ql-direction-rtl ql-align-center\"><br></p><h3 class=\"ql-align-center\">عبدالوهاب ابوشمله علي حكمي</h3><h3 class=\"ql-align-center\"><br></h3><h3 class=\"ql-align-center\">حسن عبدالله حسن القحطاني</h3><p class=\"ql-direction-rtl ql-align-center\"><br></p><h3 class=\"ql-align-center\">محمد احمد محمد حكمي</h3><p class=\"ql-direction-rtl ql-align-center\"><br></p><h3 class=\"ql-align-center\">بدر عبدالله يحي حمدي</h3><p class=\"ql-align-center\"><br></p><h3 class=\"ql-align-center ql-direction-rtl\">حسين زايد المحب مايس</h3><p class=\"ql-direction-rtl ql-align-center\"><br></p><h3 class=\"ql-align-center\">محمد جمال محمد ال يحيى</h3><h3 class=\"ql-align-center\"><br></h3><h3 class=\"ql-align-center\">نوره مسفر حسن القحطاني</h3><h3 class=\"ql-align-center\"><br></h3><h3 class=\"ql-align-center\">محمد ابراهيم محمد حكمي</h3><p class=\"ql-align-center\"><br></p><h3 class=\"ql-align-center\">حسام الدين عثمان بن عبدالله</h3><h3 class=\"ql-align-center\"><br></h3><h3 class=\"ql-align-center\">خديج احمد احمد حمدي</h3><h3 class=\"ql-align-center\"><br></h3><h3 class=\"ql-align-center\">عبدربه احمد علي حكمي</h3><h3 class=\"ql-align-center\"><br></h3><h3 class=\"ql-align-center\">ابراهيم احمد عثمان حكمي</h3><h3 class=\"ql-align-center\"><br></h3><h3 class=\"ql-align-center\">ناصر عبدالله عبدالعزيز آل زريق</h3><h3 class=\"ql-align-center ql-direction-rtl\"><br></h3>","title":"أهداف جمعية طويق","titleEn":"Tuwaiq Association Goals","updatedAt":"2026-04-03T18:51:10.442Z","contentEn":"","imageUrl":"/uploads/1771984406709-703394298.jpeg","metaDescription":"أهداف الجمعية\n\nاكتشف أهداف جمعية خيرية في الرياض تسعى إلى تنفيذ مشاريع السلة الرمضانية وسقيا الماء وإطعام الطعام وتحقيق أثر إنساني مستدام.","metaDescriptionEn":"","videoUrl":"","images":[],"id":"698109e2ac2a28bf6459451f"}
9:10:43 PM [express] GET /api/content/about 200 in 66ms :: {"_id":"697f8c26ac2a28bf645835bb","slug":"about","content":"<h1 class=\"ql-align-center\">نشأة الجمعية</h1><p class=\"ql-align-center\">تأسست جمعية طويق للخدمات الإنسانية في مدينة الرياض كمؤسسة أهلية غير ربحية تهدف إلى خدمة الفئات الأشد احتياجًا من خلال برامج إنسانية مستدامة.</p><p class=\"ql-align-center\">جاء تأسيس الجمعية استجابةً للحاجة المجتمعية المتزايدة لدعم الأسر المتعففة وتوفير الاحتياجات الأساسية لها، خاصة في المواسم ذات الأثر الكبير مثل شهر رمضان المبارك.</p><p class=\"ql-align-center\">انطلقت الجمعية برؤية واضحة تركز على إطعام الجائعين وتوفير المياه الصالحة للشرب والمساهمة في تخفيف الأعباء المعيشية عن الأسر المحتاجة.</p><p class=\"ql-align-center\">حرص المؤسسون على أن يكون العمل منظمًا ومبنيًا على أسس نظامية متوافقة مع أنظمة المملكة العربية السعودية.</p><p class=\"ql-align-center\">منذ البداية وضعت الجمعية أهدافًا استراتيجية تسعى لتحقيق أثر مباشر وملموس في حياة المستفيدين.</p><p class=\"ql-align-center\">كما اعتمدت مبدأ الشفافية في إدارة الموارد والتبرعات لضمان وصول الدعم إلى مستحقيه.</p><p class=\"ql-align-center\">وسعت الجمعية إلى بناء شراكات مع أهل الخير والمؤسسات الداعمة لتعزيز استدامة برامجها.</p><p class=\"ql-align-center\">تعمل الجمعية وفق خطط تشغيلية سنوية تراعي الأولويات الإنسانية الأكثر إلحاحًا.</p><p class=\"ql-align-center\">وتولي اهتمامًا خاصًا بالمشاريع الموسمية ذات البعد الديني والاجتماعي.</p><p class=\"ql-align-center\">وتستمر الجمعية في التوسع والتطوير لخدمة المجتمع بشكل أفضل وأكثر فاعلية.</p><p class=\"ql-align-right\"><br></p>","title":"","updatedAt":"2026-02-27T04:30:39.657Z","titleEn":"","metaDescription":"نشأة الجمعية\n\nجمعية طويق للخدمات الإنسانية جمعية خيرية في الرياض تأسست لخدمة المجتمع عبر مشاريع السلة الرمضانية وسقيا الماء وإفطار الصائمين وإطعام الجائعين وفق ","contentEn":"","imageUrl":"/uploads/1771984211456-753639049.jpeg","metaDescriptionEn":"","videoUrl":"","images":["/api/uploads/69a11deb71b8ae0097b3ce28"],"id":"697f8c26ac2a28bf645835bb"}
